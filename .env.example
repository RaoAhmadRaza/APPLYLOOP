# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every key here is required unless marked optional — the API refuses to boot without them.

ENVIRONMENT=local

# --- Postgres ---------------------------------------------------------------
# Consumed by the `db` service in compose.yml AND interpolated into DATABASE_URL.
POSTGRES_USER=applyloop
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=applyloop

# One URL for everything: psycopg3 serves both the async engine (API) and the
# sync engine (Celery + Alembic). Host is `db` inside compose, `localhost` outside.
DATABASE_URL=postgresql+psycopg://applyloop:change-me-locally@localhost:5432/applyloop

# --- Redis ------------------------------------------------------------------
# Celery broker and result backend.
REDIS_URL=redis://localhost:6379/0

# --- Scraping: layer 1, direct ATS -------------------------------------------
# How often beat fires the ATS ingest pass, in minutes. Optional; defaults to 360.
# ATS boards change on the order of a day, and the ATS layer is never proxied
# (CLAUDE.md Part 13 rule 12), so this interval is the politeness budget.
INGEST_INTERVAL_MINUTES=360

# --- Scraping: layer 3, the free feeds ---------------------------------------
# All optional. Each feed's own interval lives on its module rather than here,
# because it is a property of that provider's terms — Remotive's response asks for at
# most four requests a day — and does not change between staging and production.
FEED_PAGE_DELAY_SECONDS=1.0
# Share of the previous pass's row count below which a feed closes nothing. A feed
# returning 40 rows where it returned 1,400 is broken, not empty.
FEED_VOLUME_FLOOR=0.5
# Age at which a paginated feed's rows are closed. Absence can never close them.
FEED_STALE_DAYS=45

# --- Scraping: the registry reverse-index (CLAUDE.md 4.3) ---------------------
GROW_INTERVAL_MINUTES=60
GROW_BATCH=25
# Open roles an employer needs before it earns a six-endpoint probe.
GROW_MIN_JOBS=2
GROW_DELAY_SECONDS=1.0
# How long an employer we could not resolve is left alone before being re-probed.
GROW_RETRY_DAYS=30

# --- Scraping: layer 2, aggregators. THE ONLY PROXY IN THIS REPO -------------
# Residential proxies, comma-separated, each `user:pass@host:port`. Optional.
#
# EMPTY IS A SAFETY INTERLOCK, NOT A MISSING VALUE: with no proxy the aggregate task
# no-ops and records why. Scraping LinkedIn or Indeed from a bare datacentre or a home
# IP burns that IP. There is no override flag, on purpose.
#
# CLAUDE.md Part 13 rule 12: the ATS layer and the free feeds must NEVER use these.
#
# Do NOT set HTTP_PROXY / HTTPS_PROXY / ALL_PROXY here or in compose. Those are ambient
# and would proxy everything; the aggregator's proxy is an argument, not an environment.
JOBSPY_PROXIES=
AGGREGATE_INTERVAL_MINUTES=720

# --- M3: the LLM ------------------------------------------------------------
# An OpenAI-compatible base URL, so swapping provider is one variable rather than a
# rewrite (CLAUDE.md §7.2 "keep the interface swappable"). OpenRouter by default:
# DeepSeek's own API rejects `json_schema`, and §7.2 wants a cheap model for scoring
# and a strong one for tailoring off one key.
LLM_BASE_URL=https://openrouter.ai/api/v1
#
# EMPTY IS A SAFETY INTERLOCK, NOT A MISSING VALUE, exactly like JOBSPY_PROXIES above:
# with no key the parse task records `profile.parse_skipped` and does nothing. Nothing
# else in the pipeline notices, and CI stays green without buying credit.
#
# NEVER COMMIT A REAL KEY (Part 13 rule 9). .env is gitignored.
LLM_API_KEY=
# Résumé extraction is structured output over a few thousand tokens, once per user —
# the cheapest call in the system. The only real requirement is genuine json_schema
# support.
LLM_MODEL=google/gemini-2.5-flash
LLM_TIMEOUT_SECONDS=120

# --- M3: object storage for raw résumés (S3-compatible; R2 in production) ----
# All optional and interlocked together: unconfigured, the upload endpoint returns 503
# and everything else runs normally. A local checkout needs none of this.
#
# R2 endpoints look like https://<account-id>.r2.cloudflarestorage.com
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
# R2 has no regions, but boto3's signer requires one. "auto" is Cloudflare's own value.
STORAGE_REGION=auto
# A résumé is a handful of pages. The cap stops a huge upload exhausting the API
# process before anything has had the chance to reject it.
MAX_RESUME_BYTES=10485760

# --- M4: matching and scoring -----------------------------------------------
# Embeddings go through the same base URL and key as the chat model — OpenRouter and
# OpenAI direct both expose an OpenAI-shaped POST /embeddings. 1536 native dimensions,
# which is what job_embeddings.embedding is declared as. The value is stored verbatim in
# that table (with a template version appended), so changing it is additive.
#
# **EMBED_MODEL AND LLM_BASE_URL ARE A COUPLED PAIR. Override one, check the other.**
# The slug below is OpenRouter's. Point LLM_BASE_URL at a provider directly and it must
# lose the vendor prefix, or the provider 400s on a model it has never heard of:
#
#   LLM_BASE_URL=https://openrouter.ai/api/v1   →  EMBED_MODEL=openai/text-embedding-3-small
#   LLM_BASE_URL=https://api.openai.com/v1      →  EMBED_MODEL=text-embedding-3-small
#
# This cost a live M4 gate run. A local .env had overridden LLM_BASE_URL and LLM_MODEL to
# OpenAI direct months earlier and left EMBED_MODEL on its default, and nothing noticed —
# M3's parse gate only calls completions, so M4 was the first code in the repo to POST
# /embeddings at all. A default is only correct next to the default it was written for.
EMBED_MODEL=openai/text-embedding-3-small

# **Measured, not chosen.** Part 14 deferred this number to the M4 golden set; the set
# produced it on 2026-08-08 — the lowest threshold clearing both the precision bar and the
# recall floor on the *pooled tuning* split of 121 human-confirmed pairs. Reporting split:
# precision 0.86, recall 0.89, n=69. There is still no default in the code: unset here,
# `match_all` records `match.skipped` and does nothing. Re-derive with
# `make verify-live-match`, which prints the threshold it chose; never hand-tune it.
MATCH_THRESHOLD=20

# Jobs per profile per run that reach the LLM. This is the cost dial: everything above
# it is free, everything below is per-job spend.
MATCH_TOP_N=40
# No more than this many shortlisted jobs from one employer. Measured, not guessed: one
# company was 55% of the open pool before the registry was seeded properly.
MATCH_PER_COMPANY_CAP=5
MATCH_INTERVAL_MINUTES=720
