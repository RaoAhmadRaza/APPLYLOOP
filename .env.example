# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every key here is required unless marked optional — the API refuses to boot without them.

ENVIRONMENT=local

# --- Postgres ---------------------------------------------------------------
# Consumed by the `db` service in compose.yml AND interpolated into DATABASE_URL.
POSTGRES_USER=applyloop
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=applyloop

# One URL for everything: psycopg3 serves both the async engine (API) and the
# sync engine (Celery + Alembic). Host is `db` inside compose, `localhost` outside.
DATABASE_URL=postgresql+psycopg://applyloop:change-me-locally@localhost:5432/applyloop

# --- Redis ------------------------------------------------------------------
# Celery broker and result backend.
REDIS_URL=redis://localhost:6379/0
